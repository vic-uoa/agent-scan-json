{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:internal-json-workflow-model-advisory:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generated_by": {"type": "string", "minLength": 1},
    "executive_summary": {"type": "string"},
    "priority_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_ids", "text"],
        "properties": {
          "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_ids", "question"],
        "properties": {
          "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "seed_sample_ids", "finding_ids", "target_nodes", "attack_techniques", "input", "derivation", "expected_security_invariants", "forbidden_effects", "oracle_source", "execution_status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "seed_sample_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "target_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rule_ids": {"type": "array", "items": {"type": "string"}},
          "attack_techniques": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "input": {"type": "object", "minProperties": 1},
          "derivation": {"type": "string", "minLength": 1},
          "expected_security_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_effects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "oracle_source": {"const": "model_proposal"},
          "execution_status": {"const": "NOT_EXECUTED"}
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["generated_by"]
}

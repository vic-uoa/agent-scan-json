{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:internal-json-workflow:1.0.0",
  "type": "object",
  "anyOf": [
    {"$ref": "#/$defs/graph"},
    {
      "required": ["body"],
      "properties": {
        "body": {
          "type": "object",
          "required": ["body"],
          "properties": {"body": {"$ref": "#/$defs/graph"}}
        }
      }
    },
    {
      "required": ["workflow"],
      "properties": {
        "workflow": {
          "type": "object",
          "required": ["graph"],
          "properties": {"graph": {"$ref": "#/$defs/graph"}}
        }
      }
    }
  ],
  "$defs": {
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "id": {"type": ["string", "number", "null"]},
        "nodes": {"type": "array", "maxItems": 5000, "items": {"type": "object", "required": ["id", "data"]}},
        "edges": {"type": "array", "items": {"type": "object", "required": ["source", "target"]}}
      }
    }
  }
}
